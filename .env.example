# Copy to .env.local for `npm run dev` / `npm run login`. On Vercel, set these in Settings -> Environment Variables.

# --- From Ivanti Neurons: Admin > App Registrations > New Registration > AI Agent ---
NEURONS_AUTH_URL=
NEURONS_CLIENT_ID=

# --- Dashboard ---
# Password for the dashboard page (also used by `npm run login` to upload the Ivanti sign-in).
DASHBOARD_PASSWORD=
# Optional: secret for signing the login cookie (defaults to one derived from DASHBOARD_PASSWORD).
# SESSION_SECRET=
# Vercel Cron sends this as a Bearer token to /api/cron/refresh (daily refresh keeps the sign-in alive).
CRON_SECRET=
# How long cached data is reused before re-collecting from Ivanti (minutes).
# SNAPSHOT_TTL_MINUTES=15

# Upstash Redis — added automatically when you connect an Upstash store in Vercel's Storage tab.
# Needed locally only if you want `npm run dev` to share the Vercel store.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Used by `npm run login` (optional; it asks if missing)
# DASHBOARD_URL=https://your-app.vercel.app

# --- Optional Ivanti overrides ---
# NEURONS_MCP_DOMAINS=device,dataservices,patch,exposures,software-inventory,software-distribution,reporting
# NEURONS_MCP_BASE_URL=https://<tenant>.ivanticloud.com
# NEURONS_AUTHORIZATION_ENDPOINT=
# NEURONS_TOKEN_ENDPOINT=
# NEURONS_OAUTH_SCOPES=
# NEURONS_OAUTH_RESOURCE=none
# PUBLIC_BASE_URL=https://your-app.vercel.app
