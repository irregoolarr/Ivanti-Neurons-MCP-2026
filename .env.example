# Copy to .env.local for local dev. On Vercel, set these in Project Settings -> Environment Variables.

# --- From Ivanti Neurons: Admin > App Registrations > New Registration > AI Agent ---
NEURONS_AUTH_URL=
NEURONS_CLIENT_ID=

# --- Optional ---
# Only some domains (comma-separated). Default: all seven.
# NEURONS_MCP_DOMAINS=device,dataservices,patch,exposures,software-inventory,software-distribution,reporting

# Base that /mcp/<domain>/v1 is appended to. Default: NEURONS_AUTH_URL.
# Set to just the host (https://<tenant>.ivanticloud.com) if /health?probe=1 shows 404s.
# NEURONS_MCP_BASE_URL=

# Only needed if /health?probe=1 shows "source": "guessed" and sign-in fails.
# NEURONS_AUTHORIZATION_ENDPOINT=
# NEURONS_TOKEN_ENDPOINT=
# NEURONS_OAUTH_SCOPES=
# NEURONS_OAUTH_RESOURCE=none        # none (default) | auto | explicit value(s), comma-separated

# Public URL of this deployment. Auto-detected on Vercel; set it if you use a custom domain behind a proxy.
# PUBLIC_BASE_URL=https://your-app.vercel.app
