{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/", "destination": "/api/index?__path=" },
    { "source": "/:path*", "destination": "/api/index?__path=:path*" }
  ],
  "functions": {
    "api/index.ts": { "maxDuration": 300, "includeFiles": "dashboard/**" }
  },
  "crons": [{ "path": "/api/cron/refresh", "schedule": "0 6 * * *" }]
}
